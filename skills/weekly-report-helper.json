{
  "Id": "weekly-report-helper",
  "Name": "周报助手",
  "Description": "v0.12 多步工作流：校验笔记 → 压缩配图。生成结构化周报前先验证本周笔记完整性，再压缩报告里要用的配图。",
  "Icon": "📝",
  "PromptTemplate": "",
  "Tools": ["HashFiles", "BatchResizeImage"],
  "Category": "文档处理",
  "IsBuiltIn": false,
  "Source": "market:community",
  "Version": "1.0.0",
  "Steps": [
    {
      "ToolName": "HashFiles",
      "Args": {
        "directory": "Documents/工作记录/",
        "algorithm": "SHA256",
        "outputCsv": "Documents/工作记录/_本周哈希.csv"
      },
      "Description": "校验本周工作记录文件完整性，输出 SHA256 清单",
      "Optional": false
    },
    {
      "ToolName": "BatchResizeImage",
      "Args": {
        "directory": "Documents/工作记录/_本周配图/",
        "outputDirectory": "Documents/工作记录/_本周配图_压缩/",
        "maxWidth": 1920,
        "maxHeight": 1080,
        "format": "jpeg",
        "quality": 85
      },
      "Description": "压缩本周报告要用的配图（可选用，没有配图目录则跳过）",
      "Optional": true
    }
  ]
}
