{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "DeskPilot v2",
  "version": "0.0.1",
  "identifier": "com.deskpilot.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeskPilot v2 (Tauri MVP)",
        "width": 900,
        "height": 640,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/deskpilot-server"
    ]
  },
  "plugins": {}
}
