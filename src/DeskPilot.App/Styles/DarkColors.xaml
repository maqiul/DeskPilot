<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 暗色主题 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF7A28"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF9447"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="CardBrush" Color="#252525"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#999999"/>
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#3A2A1A"/>
    <SolidColorBrush x:Key="AssistantBubbleBrush" Color="#2D2D2D"/>

</ResourceDictionary>
