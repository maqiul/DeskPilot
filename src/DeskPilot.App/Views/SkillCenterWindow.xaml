<Window x:Class="DeskPilot.App.Views.SkillCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DeskPilot.App.ViewModels"
        xmlns:local="clr-namespace:DeskPilot.App"
        mc:Ignorable="d"
        Title="🛠  DeskPilot 技能中心" Height="640" Width="960"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=vm:SkillCenterViewModel}">

    <Window.Resources>
        <!-- 标题样式 -->
        <Style x:Key="HeaderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="HeaderSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- Tab 头部样式：橙底白字选中态 -->
        <Style x:Key="SkillCenterTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Indicator" Height="3"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource PrimaryBrush}"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态栏卡片样式 -->
        <Style x:Key="StatusBarCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- v0.15 D3: 市场源 Tab 横排按钮样式 -->
        <Style x:Key="SourceTabButton" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v0.15 D3: 分类 chip 样式（小圆角矩形按钮） -->
        <Style x:Key="CategoryChipButton" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v0.15 D3: 技能市场卡片样式（280px 宽，Icon + Name + Description + 来源徽章 + 评分 + 下载数） -->
        <Style x:Key="MarketSkillCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <!-- Ctrl+F 聚焦搜索框（MainTabs 第一个 Tab 市场搜索） -->
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding LoadMarketCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <StackPanel Grid.Row="0" Margin="20,18,20,12">
            <TextBlock Text="🛠 技能中心" Style="{StaticResource HeaderTitle}"/>
            <TextBlock Text="浏览 / 安装 / 管理 DeskPilot 的所有技能（内置 + 市场）"
                       Style="{StaticResource HeaderSubtitle}"/>
        </StackPanel>

        <!-- 主 TabControl：Market / Installed / Updates -->
        <Border Grid.Row="1" Margin="20,0,20,0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0"
                        ItemContainerStyle="{StaticResource SkillCenterTabItem}">

                <!-- D3 技能市场 Tab：源 Tab 横排 + 分类 chips + 搜索框 + 3 列卡片网格 -->
                <TabItem Header="🌐  技能市场">
                    <Grid x:Name="MarketTabContent" Margin="16">
                        <Grid.RowDefinitions>
                            <!-- 源 Tab 横排 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 分类 chips -->
                            <RowDefinition Height="Auto"/>
                            <!-- 搜索框 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 卡片网格 -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 源 Tab 横排 + + 自定义按钮 -->
                        <ItemsControl Grid.Row="0" ItemsSource="{Binding MarketplaceSourceNames}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="MarketSource"
                                                 Content="{Binding}">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton" BasedOn="{StaticResource SourceTabButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{x:Static local:SourceMatchConverter.Instance}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.SelectedMarketSource" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="IsChecked" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 分类 chips -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding MarketCategories}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="Category"
                                                 Content="{Binding}">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton" BasedOn="{StaticResource CategoryChipButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{x:Static local:CategoryMatchConverter.Instance}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.MarketCategory" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="IsChecked" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 搜索框 + 刷新按钮 -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="MarketSearchBox"
                                     Text="{Binding MarketSearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                     Padding="10,8" FontSize="13"
                                     Background="{StaticResource CardBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Center">
                                <TextBox.ToolTip>
                                    <ToolTip Content="搜索技能名 / 描述 / ID（实时过滤）"/>
                                </TextBox.ToolTip>
                            </TextBox>
                            <Button Grid.Column="1" Content="🔄 刷新市场"
                                    Command="{Binding LoadMarketCommand}"
                                    Padding="14,8" Margin="8,0,0,0" Cursor="Hand"
                                    Background="{StaticResource PrimaryBrush}"
                                    Foreground="White"
                                    BorderThickness="0"/>
                        </Grid>

                        <!-- 3 列 WrapPanel 卡片网格 -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="MarketSkillGrid" ItemsSource="{Binding MarketSkillRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" Margin="0"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MarketSkillCard}"
                                                ToolTip="点击查看详情 / 安装">
                                            <StackPanel>
                                                <!-- Icon + Name + 来源徽章 行 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                                            Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Icon}" FontSize="22"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Author}" FontSize="10"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" CornerRadius="4" Padding="4,2"
                                                            Background="{StaticResource CardBrush}" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding SourceName}" FontSize="9"
                                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <!-- 描述 3 行截断 -->
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Margin="0,8,0,0"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="48"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- 评分 + 下载数 + 版本 -->
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding Rating, StringFormat='⭐ {0:F1}'}" FontSize="10"
                                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    <TextBlock Text="{Binding Downloads, StringFormat='📥 {0}'}" FontSize="10"
                                                               Margin="8,0,0,0"
                                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="10"
                                                               Margin="8,0,0,0"
                                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                                <!-- 分类 + 已安装标识 -->
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="9"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               Padding="4,1" Background="{StaticResource PrimaryHoverBrush}"/>
                                                    <TextBlock Text=" ✅ 已安装" FontSize="9" Margin="6,0,0,0"
                                                               Foreground="Green"
                                                               Visibility="{Binding IsInstalled, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- D4 已安装 Tab：ListView 显示 builtin + 已安装技能（Name + Version + Author + 启用 checkbox + 卸载按钮） -->
                <TabItem Header="📦  已安装">
                    <Grid x:Name="InstalledTabContent" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 操作栏 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="🔄 刷新列表" Command="{Binding LoadInstalledCommand}"
                                    Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                                    Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"/>
                            <TextBlock Text="💡 内置技能不可卸载" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <!-- ListView -->
                        <ListView Grid.Row="1" ItemsSource="{Binding InstalledSkills}"
                                  Background="Transparent" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridView.Columns>
                                        <GridViewColumn Header="图标" Width="50">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Icon}" FontSize="20"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="技能名" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="版本" Width="80" DisplayMemberBinding="{Binding Version}"/>
                                        <GridViewColumn Header="分类" Width="100" DisplayMemberBinding="{Binding Category}"/>
                                        <GridViewColumn Header="作者" Width="120" DisplayMemberBinding="{Binding Source}"/>
                                        <GridViewColumn Header="操作" Width="180">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="🗑 卸载" Padding="8,4"
                                                                Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Id}"
                                                                Cursor="Hand" FontSize="11"
                                                                Background="#FF6B6B" Foreground="White" BorderThickness="0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView.Columns>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>
                <!-- D4 更新 Tab：ListView 显示有更新的技能（一键更新按钮） -->
                <TabItem Header="🔄  有更新">
                    <Grid x:Name="UpdatesTabContent" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 操作栏 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="🔄 检查更新" Command="{Binding LoadUpdatesCommand}"
                                    Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                                    Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"/>
                            <TextBlock Text="💡 仅显示有更新的技能" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <!-- ListView -->
                        <ListView Grid.Row="1" ItemsSource="{Binding UpdateAvailableSkills}"
                                  Background="Transparent" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridView.Columns>
                                        <GridViewColumn Header="技能 ID" Width="200" DisplayMemberBinding="{Binding Id}"/>
                                        <GridViewColumn Header="本地版本" Width="120" DisplayMemberBinding="{Binding InstalledVersion}"/>
                                        <GridViewColumn Header="最新版本" Width="120" DisplayMemberBinding="{Binding LatestVersion}"/>
                                        <GridViewColumn Header="操作" Width="200">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="⬆ 一键更新" Padding="10,6"
                                                            Command="{Binding DataContext.UpdateSkillCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand" FontSize="12"
                                                            Background="#52C41A" Foreground="White" BorderThickness="0"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView.Columns>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- 底部状态栏 -->
        <Grid Grid.Row="2" Margin="20,12,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatusBarCard}" Margin="0,0,12,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatusBarCard}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="当前源：" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding SelectedMarketSource}" FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="4,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>