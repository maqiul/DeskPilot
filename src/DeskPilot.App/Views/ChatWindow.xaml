<Window x:Class="DeskPilot.App.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DeskPilot.App.ViewModels"
        xmlns:local="clr-namespace:DeskPilot.App"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="680" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=vm:ChatViewModel}">

    <Window.Resources>
        <!-- 圆角输入框（12px） -->
        <Style x:Key="RoundInput" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- 卡片阴影 -->
        <Style x:Key="CardShadow" TargetType="Border">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.06" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <!-- v0.15: Ctrl+Shift+K 打开技能中心 -->
        <KeyBinding Key="K" Modifiers="Ctrl+Shift" Command="{Binding ShowSkillCenterCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- v0.15: 顶部菜单条（文件 / 技能 / 帮助） -->
        <Menu Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="设置(_S)..." Command="{Binding ShowSettingsCommand}"/>
                <Separator/>
                <!-- v0.22.0: 导出对话为 Markdown 文件 -->
                <MenuItem Header="导出对话(_E)..." Click="ExportMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="退出(_X)" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="技能(_K)">
                <MenuItem Header="打开技能中心(_C)..." Command="{Binding ShowSkillCenterCommand}" InputGestureText="Ctrl+Shift+K"/>
                <Separator/>
                <MenuItem Header="刷新已安装技能(_R)" Command="{Binding RefreshSkillsCommand}"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于 DeskPilot(_A)..." Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <!-- 快捷技能横条（标题栏下方折叠） -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8"
                            Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="✈" FontSize="20" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DeskPilot" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="你的桌面 AI 副驾驶" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Content="清空对话"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearCommand}"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="3" Content="⚙ 设置"
                        Style="{StaticResource SecondaryButton}"
                        Click="OpenSettings_Click"/>
            </Grid>

                <!-- v0.9 + v0.10: 快捷技能横条（内置+已安装合并，有更新显示 🔄 角标） -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0"
                              Padding="0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ItemsControl Grid.Column="0" ItemsSource="{Binding EnabledSkills}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="12,8" Margin="0,0,8,0"
                                            Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Style="{StaticResource CardShadow}"
                                            Cursor="Hand" Tag="{Binding}"
                                            MouseLeftButtonUp="SkillCard_Click"
                                            ToolTip="{Binding Description}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="16"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center"/>
                                            <!-- v0.10: 有更新角标（🔄）—— 绑定 HasUpdate 属性 -->
                                            <TextBlock Text="🔄" FontSize="11"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                                       Foreground="#E65100"
                                                       ToolTip="该技能有可用更新"
                                                       Visibility="{Binding HasUpdate, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- v0.10: 已安装数量标签（横条右侧） -->
                        <Border Grid.Column="1" CornerRadius="8" Padding="8,4"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center" Margin="8,0,0,0"
                                ToolTip="从技能市场安装的技能数量">
                            <TextBlock FontSize="11" Foreground="{StaticResource SecondaryTextBrush}">
                                <Run Text="📦 已安装 "/>
                                <Run Text="{Binding InstalledSkillCount, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 消息区 -->
        <Grid Grid.Row="1">
            <!-- v0.12: 多步执行进度卡片（仅在 StepProgresses 非空时显示） -->
            <Border Margin="20,12,20,0" Padding="14,10" CornerRadius="10"
                    Background="#FFF7E6" BorderBrush="#FFB74D" BorderThickness="1"
                    Visibility="{Binding HasStepProgress, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                <StackPanel>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#E65100" Margin="0,0,0,6">
                        <Run Text="⚙ 正在执行技能步骤"/>
                        <Run Text="…（" FontWeight="Regular"/>
                        <Run Text="{Binding StepProgresses.Count, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text=" 步）" FontWeight="Regular"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding StepProgresses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="13"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextBrush}">
                                            <Run Text="第 "/>
                                            <Run Text="{Binding Index}" FontWeight="SemiBold"/>
                                            <Run Text=" 步："/>
                                            <Run Text="{Binding ToolName}" FontFamily="Consolas" Foreground="{StaticResource PrimaryBrush}"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding Description}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding Summary, Converter={x:Static local:StringToVisibilityConverter.Instance}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- v0.24.0: 对话搜索框（仅在有消息时显示） -->
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,8"
                    Visibility="{Binding HasMessages, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             Background="Transparent" BorderThickness="0" FontSize="13"
                             Foreground="{StaticResource TextBrush}"
                             ToolTip="搜索当前对话中的关键词（实时过滤）"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="8,0,0,0"
                               Text="{Binding MatchCountText}"/>
                </Grid>
            </Border>
            <!-- 消息列表（无消息时隐藏） -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="20,16" x:Name="MessagesScrollViewer"
                          Visibility="{Binding HasMessages, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                <ItemsControl ItemsSource="{Binding FilteredMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,16">
                                <Grid.HorizontalAlignment>
                                    <PriorityBinding>
                                        <Binding Path="Role" Converter="{x:Static local:RoleToAlignmentConverter.Instance}"/>
                                    </PriorityBinding>
                                </Grid.HorizontalAlignment>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 头像（user 在右，assistant 在左）-->
                                <Border Grid.Column="{Binding Role, Converter={x:Static local:RoleToAvatarColumnConverter.Instance}}"
                                        Width="36" Height="36" CornerRadius="18"
                                        Background="{Binding Role, Converter={x:Static local:RoleToAvatarBrushConverter.Instance}}"
                                        VerticalAlignment="Top" Margin="0,2,10,0">
                                    <TextBlock Text="{Binding Role, Converter={x:Static local:RoleToAvatarConverter.Instance}}"
                                               FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- 气泡 -->
                                <Border Grid.Column="1" Style="{StaticResource CardShadow}"
                                        CornerRadius="12" Padding="14,10"
                                        MaxWidth="620"
                                        Background="{Binding Role, Converter={x:Static local:RoleToBubbleBrushConverter.Instance}}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LocalTimeText}"
                                                       FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding Role, Converter={x:Static local:RoleToLabelConverter.Instance}}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   FontSize="14" LineHeight="20"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <Button HorizontalAlignment="Right" Margin="0,6,0,0" Padding="8,2"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="复制此消息"
                                                Content="📋" FontSize="12"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <Button HorizontalAlignment="Right" Margin="0,6,0,0" Padding="8,2"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="从对话中删除此消息"
                                                Content="🗑" FontSize="12"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <Button HorizontalAlignment="Right" Margin="0,6,0,0" Padding="8,2"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.RegenerateMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="使用相同 prompt 重新生成回复"
                                                Content="🔄" FontSize="12"
                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                Visibility="{Binding Role, Converter={x:Static local:RoleToRegenVisibilityConverter.Instance}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态欢迎卡片 -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="520" Padding="32,28"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16"
                    Style="{StaticResource CardShadow}"
                    Visibility="{Binding HasMessages, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="👋 你好，我是 DeskPilot" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="有什么可以帮你的？" FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,20"/>

                    <UniformGrid Columns="2" Width="460" HorizontalAlignment="Center">
                        <Button Content="📁 整理下载文件夹里的 PDF" Margin="4"
                                Style="{StaticResource SecondaryButton}"
                                Click="Suggestion_Click" Tag="帮我把下载文件夹里的 PDF 按月份归档"/>
                        <Button Content="🔍 找出重复的照片" Margin="4"
                                Style="{StaticResource SecondaryButton}"
                                Click="Suggestion_Click" Tag="帮我找出桌面上重复的照片"/>
                        <Button Content="📝 批量重命名文件" Margin="4"
                                Style="{StaticResource SecondaryButton}"
                                Click="Suggestion_Click" Tag="把 D:\docs 下所有 txt 改成 md 后缀"/>
                        <Button Content="💬 跟我聊聊" Margin="4"
                                Style="{StaticResource SecondaryButton}"
                                Click="Suggestion_Click" Tag="跟我随便聊聊吧"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 输入区 -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="12"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <TextBox x:Name="InputBox"
                             Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="False"
                             Style="{StaticResource RoundInput}"
                             BorderThickness="0"
                             Background="Transparent"
                             KeyDown="InputBox_KeyDown"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                            Margin="0,0,8,0"/>
                    <Button Content="发送" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SendCommand}"
                            MinWidth="80"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 跳动点加载指示器 -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="20" Padding="14,8"
                Margin="0,0,0,18"
                Visibility="{Binding IsBusy, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <StackPanel Orientation="Horizontal">
                <Canvas Width="48" Height="10" x:Name="DotsCanvas">
                    <Ellipse Canvas.Left="0" Canvas.Top="3" Width="8" Height="8"
                             Fill="{StaticResource PrimaryBrush}">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)"
                                                         From="3" To="-2" Duration="0:0:0.4"
                                                         AutoReverse="True" BeginTime="0:0:0"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Canvas.Left="20" Canvas.Top="3" Width="8" Height="8"
                             Fill="{StaticResource PrimaryBrush}">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)"
                                                         From="3" To="-2" Duration="0:0:0.4"
                                                         AutoReverse="True" BeginTime="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Canvas.Left="40" Canvas.Top="3" Width="8" Height="8"
                             Fill="{StaticResource PrimaryBrush}">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)"
                                                         From="3" To="-2" Duration="0:0:0.4"
                                                         AutoReverse="True" BeginTime="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Canvas>
                <TextBlock Text="AI 思考中..." Margin="10,0,0,0" FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 工具状态栏 -->
        <Border Grid.Row="3" Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,8"
                Visibility="{Binding ToolStatus, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding ToolStatus}" FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
