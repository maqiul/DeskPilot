<Window x:Class="DeskPilot.App.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DeskPilot.App.ViewModels"
        xmlns:local="clr-namespace:DeskPilot.App"
        mc:Ignorable="d"
        Title="DeskPilot 桌面 AI 助手" Height="640" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=vm:ChatViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✈️" FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock Text="DeskPilot" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Text="· 你的桌面 AI 副驾驶" FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="清空对话"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearCommand}"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="3" Content="⚙ 设置"
                        Style="{StaticResource SecondaryButton}"
                        Click="OpenSettings_Click"/>
            </Grid>
        </Border>

        <!-- 消息列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="16" x:Name="MessagesScrollViewer">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Grid.HorizontalAlignment>
                                <PriorityBinding>
                                    <Binding Path="Role" Converter="{x:Static local:RoleToAlignmentConverter.Instance}"/>
                                </PriorityBinding>
                            </Grid.HorizontalAlignment>
                            <Border CornerRadius="10" Padding="12"
                                    MaxWidth="640"
                                    Background="{Binding Role, Converter={x:Static local:RoleToBubbleBrushConverter.Instance}}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Role, Converter={x:Static local:RoleToLabelConverter.Instance}}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 输入区 -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0"
                         Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="False"
                         FontSize="14"
                         Padding="10,8"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         KeyDown="InputBox_KeyDown"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                            Margin="0,0,8,0"/>
                    <Button Content="发送" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SendCommand}"
                            MinWidth="80"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 加载指示器 -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12,6"
                Margin="0,0,0,16"
                Visibility="{Binding IsBusy, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar IsIndeterminate="True" Width="80" Height="4"
                             Foreground="{StaticResource PrimaryBrush}" BorderThickness="0"/>
                <TextBlock Text="AI 思考中..." Margin="8,0,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>