<Window x:Class="DeskPilot.App.Views.SkillDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskPilot.App"
        Title="技能详情" Width="560" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ① 顶部：Icon 大块 + 名称/版本/作者/分类 + ★ 评分 + 下载数 + 右上来源徽章 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Icon 大块 -->
            <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40"
                    Background="#E3F2FD" Margin="0,0,16,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Icon}" FontSize="42"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <!-- 信息 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Text="{Binding Name}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" CornerRadius="8" Padding="8,3"
                            Background="#E8F5E9" BorderBrush="#66BB6A" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#2E7D32"/>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="v" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding Version}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text=" · 作者 " FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="6,0,0,0"/>
                    <TextBlock Text="{Binding Author}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding RatingText}" FontSize="13" Foreground="#F57C00" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DownloadsText}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="14,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ② 中间：Description + Prompt 预览 + Tools -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 完整描述 -->
                <TextBlock Text="{Binding Description}" FontSize="13"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,14"/>

                <!-- Prompt 模板预览（只读 + 复制） -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📝  Prompt 模板"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="📋 复制" Style="{StaticResource SecondaryButton}"
                            Padding="8,3" FontSize="11"
                            Command="{Binding CopyPromptCommand}"/>
                </Grid>
                <Border CornerRadius="6" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,14">
                    <TextBox Text="{Binding PromptPreview, Mode=OneWay}" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0"
                             FontFamily="Consolas, Microsoft YaHei Mono, monospace" FontSize="11"
                             TextWrapping="Wrap" MinHeight="100" MaxHeight="160"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>

                <!-- Tools 列表（chips） -->
                <TextBlock Text="🔧  依赖工具" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Tools}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="10,4" Margin="0,0,6,4"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding}" FontSize="11"
                                           Foreground="{StaticResource TextBrush}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 状态条 -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ③ 分隔条 -->
        <Separator Grid.Row="2" Background="{StaticResource BorderBrush}" Margin="0,8,0,12"/>

        <!-- ④ 底部：安装 / 卸载 / 关闭 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="🗑 卸载" Style="{StaticResource SecondaryButton}"
                    Padding="14,7" FontSize="12" Margin="0,0,8,0"
                    Command="{Binding UninstallCommand}"
                    IsEnabled="{Binding IsInstalled}"
                    Visibility="{Binding IsInstalled, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
            <Button Grid.Column="1" Content="📥 安装" Style="{StaticResource PrimaryButton}"
                    Padding="14,7" FontSize="12" Margin="0,0,8,0"
                    Command="{Binding InstallCommand}"
                    IsEnabled="{Binding IsInstalled, Converter={x:Static local:BoolToNegationConverter.Instance}}"
                    Visibility="{Binding IsInstalled, Converter={x:Static local:BoolToNegationConverter.Instance}}"/>
            <Button Grid.Column="2" Content="关闭" Style="{StaticResource SecondaryButton}"
                    Padding="14,7" FontSize="12" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>