<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeskPilot.Server</RootNamespace>
    <AssemblyName>deskpilot-server</AssemblyName>
    <!-- v0.0.3: sidecar 必须 self-contained + 所有运行时 .dll 在同目录。
         Tauri cargo build 会自动从 binaries/ copy 到 target/release/。 -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- 复用现有 IChatService 接口（语义内核封装）+ 18 工具 -->
    <ProjectReference Include="..\DeskPilot.Core\DeskPilot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- v0.0.2 MVP 阶段用 StubChatService；v0.0.3 替换为 SemanticKernelChatService -->
    <InternalsVisibleTo Include="DeskPilot.Tests" />
  </ItemGroup>

</Project>